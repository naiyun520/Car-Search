; 本文件仅用于说明配置结构，不需要手工重命名。
; 正式 .env 由 /install/ 安装向导自动生成。

[APP]
INSTALLED = false
DEBUG = false
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = car_inquiry
USERNAME = car_inquiry
PASSWORD =
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = ci_

[SECURITY]
DATA_ENCRYPT_KEY =

[WECHAT]
APP_ID =
APP_SECRET =
OFFER_ID =
SANDBOX_APP_KEY =
PRODUCTION_APP_KEY =
PAY_ENV = 0
